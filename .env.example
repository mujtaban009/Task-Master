# ==============================================================================
# 3-Tier API Key & Security Architecture Configuration
# ==============================================================================

# 1. Backend API Key (Frontend -> Backend Communication)
# Required by the frontend in header: `X-API-Key`
BACKEND_API_KEY=bk_live_4d9f8a2e1c7b05e3a6f82c1b9d4e7a2c

# 2. Database API Key (Backend & Chatbot -> PostgreSQL Connection)
# Used by both backends to authenticate with the shared PostgreSQL database
DATABASE_API_KEY=postgres

# 3. Chatbot Microservice API Key (Frontend -> Chatbot Service)
# Required in header: `X-Chatbot-API-Key`
CHATBOT_API_KEY=cb_live_8f3a9e14c72b05d1e67a42b98f2316
CHATBOT_SERVICE_URL=http://127.0.0.1:8001/api/chat

# ==============================================================================
# PostgreSQL Connection Configuration (Shared Database: todo_app)
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=todo_app
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/todo_app

# Async (Used in Phase 2 FastAPI):
ASYNC_DATABASE_URL=postgresql+psycopg_async://postgres:your_secure_password_here@localhost:5432/todo_app

# Security & Authentication (For Phase 2)
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

